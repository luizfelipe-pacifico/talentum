{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "talentum",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talentum-cloud-production",
      "database_id": "1b318089-b60f-405b-a709-412490fb4906",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "ALLOWED_ORIGIN": "https://talentum.vercel.app"
  }
}
