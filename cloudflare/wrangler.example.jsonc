{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talentum",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talentum-cloud-production",
      "database_id": "COLE_AQUI_O_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Cron: retenção mínima do D1 e busca das notícias públicas (docs/ARCHITECTURE.md §3.8).
  // Entra em vigor no próximo deploy; não exige segredo.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "ALLOWED_ORIGIN": "https://talentum.vercel.app",
    "PUBLIC_WEB_URL": "https://talentum.vercel.app"
  },
  // Workers AI para os resumos de notícias (Stage 16). Opcional: sem o binding,
  // o Worker usa o trecho inicial da notícia. Habilitar tem custo de uso; só
  // descomente depois de autorizar no painel da Cloudflare.
  // "ai": { "binding": "AI" }
}
