# Dependências e saídas de build
node_modules/
.next/
.next-e2e/
test-results/
playwright-report/
dist/
out/
build/
release/
coverage/
.turbo/
.vercel/
*.tsbuildinfo

# Segredos e configuração de ambiente
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Material criptográfico. Inclui a chave local que protege identificadores
# PIX no dispositivo: ela vive ao lado do SQLite e nunca entra no Git.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ecdsa
id_ed25519
*.asc

# Bancos locais, dumps e backups
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.dump
*.sql.gz
*.bak
*.backup
temp/
tmp
*.tsbuildinfo
.wrangler/

# Local credentials and private key material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Logs, traces, and local diagnostics
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
lerna-debug.log*
*.trace
*.har
*.pid
*.pid.lock
logs/
crash-reports/

# Generated build output and local tool/editor state
build/
coverage/
.cache/
.turbo/
.vercel/
.eslintcache
.vscode-test/
.history/
.DS_Store
Thumbs.db

# Capturas e relatórios de trabalho das skills de design (taste-skill)
.taste-skill/

# Fontes raster das ilustrações de estado: os mestres vetoriais em design/estados-vetor são a fonte versionada.
design/estados-fonte/

*.orig
*.rej

# Extratos e faturas. Arquivo bancário real nunca entra no repositório
# (docs/PRODUCT.md, mandatory rule 10). Fixtures precisam ser sintéticas e ficam
# em tests/fixtures/, o único caminho liberado.
*.csv
*.ofx
*.qif
*.pdf
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.ofx
!tests/fixtures/**/*.qif
!docs/**/*.pdf

# Logs, diagnósticos e transcrições
yarn-error.log*
*.heapsnapshot
*.cpuprofile

# Estado local de ferramentas e do editor
.vscode/
.idea/
*.swp
