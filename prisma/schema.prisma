generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LocalProfile {
  id          String          @id @default(uuid())
  displayName String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  preferences UserPreference[]
  institutions Institution[]
  accounts      Account[]
  categories    Category[]
  importBatches ImportBatch[]
  transactions  Transaction[]
  obligations   ScheduledObligation[]
}

model UserPreference {
  id        String       @id @default(uuid())
  profileId String
  key       String
  value     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@index([profileId])
}

model Institution {
  id        String       @id @default(uuid())
  profileId String
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accounts  Account[]

  @@index([profileId])
}

model Account {
  id               String            @id @default(uuid())
  profileId        String
  institutionId    String?
  name             String
  type             String
  currency         String            @default("BRL")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          LocalProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution      Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  balanceSnapshots BalanceSnapshot[]
  transactions     Transaction[]
  obligations      ScheduledObligation[]

  @@index([profileId])
  @@index([institutionId])
}

model BalanceSnapshot {
  id           String   @id @default(uuid())
  accountId    String
  balanceCents BigInt
  capturedAt   DateTime
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

model Category {
  id           String        @id @default(uuid())
  profileId    String
  name         String
  kind         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  obligations  ScheduledObligation[]

  @@unique([profileId, name, kind])
  @@index([profileId])
}

model ImportBatch {
  id          String        @id @default(uuid())
  profileId   String
  format      String
  fingerprint String
  status      String
  fileName    String?
  importedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([profileId, fingerprint])
  @@index([profileId, importedAt])
}

model Transaction {
  id            String        @id @default(uuid())
  profileId     String
  accountId     String
  importBatchId String?
  categoryId    String?
  occurredOn    DateTime
  description   String
  amountCents   BigInt
  status        String        @default("pending")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId, occurredOn])
  @@index([accountId, occurredOn])
  @@index([importBatchId])
  @@index([categoryId])
}

/// Compromisso com valor e vencimento. Subtraendo do Saldo Livre de Risco.
/// `status` é indispensável: sem ele, obrigação já paga continuaria sendo
/// descontada e o veredito ficaria errado por construção (docs/DASHBOARD.md, L-1).
model ScheduledObligation {
  id          String       @id @default(uuid())
  profileId   String
  accountId   String?
  categoryId  String?
  description String
  amountCents BigInt
  dueDate     DateTime
  /// open | paid | cancelled
  status      String       @default("open")
  /// none | monthly | weekly | yearly
  recurrence  String       @default("none")
  /// Valor informado como aproximado no onboarding.
  isEstimated Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  profile     LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId, status, dueDate])
  @@index([accountId])
  @@index([categoryId])
}
