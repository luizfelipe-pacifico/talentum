generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LocalProfile {
  id          String          @id @default(uuid())
  displayName String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  preferences UserPreference[]
  institutions Institution[]
  accounts      Account[]
  categories    Category[]
  importBatches ImportBatch[]
  transactions  Transaction[]
  obligations   ScheduledObligation[]
  csvMappings   CsvMappingProfile[]
  onboardingSessions OnboardingSession[]
  onboardingAnswers  OnboardingAnswer[]
  incomes       IncomeSource[]
  merchantRules MerchantRule[]
}

model OnboardingSession {
  id          String             @id @default(uuid())
  profileId   String
  status      String             @default("draft")
  currentStep String             @default("profile")
  version     Int                @default(1)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  profile     LocalProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers     OnboardingAnswer[]

  @@index([profileId, status, updatedAt])
}

model OnboardingAnswer {
  id                    String            @id @default(uuid())
  onboardingSessionId   String
  profileId             String
  questionKey           String
  valueJson             String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  onboardingSession     OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)
  profile               LocalProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([onboardingSessionId, questionKey])
  @@index([profileId])
}

model UserPreference {
  id        String       @id @default(uuid())
  profileId String
  key       String
  value     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@index([profileId])
}

model Institution {
  id        String       @id @default(uuid())
  profileId String
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile     LocalProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accounts    Account[]
  csvMappings CsvMappingProfile[]

  @@index([profileId])
}

model Account {
  id               String            @id @default(uuid())
  profileId        String
  institutionId    String?
  name             String
  type             String
  currency         String            @default("BRL")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          LocalProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution      Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  balanceSnapshots BalanceSnapshot[]
  transactions     Transaction[]
  obligations      ScheduledObligation[]
  importBatches    ImportBatch[]
  incomes          IncomeSource[]

  @@index([profileId])
  @@index([institutionId])
}

model BalanceSnapshot {
  id           String       @id @default(uuid())
  accountId    String
  balanceCents BigInt
  capturedAt   DateTime
  /// Lote que gravou este saldo, quando ele veio de uma importação. É o que
  /// permite desfazer a importação sem apagar um saldo informado à mão depois.
  importBatchId String?
  createdAt    DateTime     @default(now())
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importBatch  ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([accountId, capturedAt])
  @@index([importBatchId])
}

model Category {
  id           String        @id @default(uuid())
  profileId    String
  name         String
  kind         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  obligations  ScheduledObligation[]
  merchantRules MerchantRule[]

  @@unique([profileId, name, kind])
  @@index([profileId])
}

/// Lote de importação. `periodStart`/`periodEnd` registram o intervalo que o
/// arquivo cobre — não a data em que foi importado. Sem eles o sistema não
/// distingue "mês sem movimento" de "mês sem extrato" (docs/DASHBOARD.md, L-2).
model ImportBatch {
  id             String        @id @default(uuid())
  profileId      String
  accountId      String?
  format         String
  fingerprint    String
  status         String
  fileName       String?
  /// Primeiro dia civil coberto pelo arquivo.
  periodStart    DateTime?
  /// Último dia civil coberto pelo arquivo.
  periodEnd      DateTime?
  /// Linhas convertidas com sucesso pelo parser.
  rowCount       Int           @default(0)
  /// Linhas efetivamente gravadas como transação.
  importedCount  Int           @default(0)
  /// Linhas descartadas por já existirem na conta.
  duplicateCount Int           @default(0)
  importedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  profile        LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  files            ImportFile[]
  issues           ImportIssue[]
  balanceSnapshots BalanceSnapshot[]

  @@unique([profileId, fingerprint])
  @@index([profileId, importedAt])
  @@index([accountId])
  @@index([profileId, periodStart, periodEnd])
}

/// Metadados do arquivo importado. O conteúdo bruto não é retido: o extrato é
/// processado em memória e descartado (docs/HOW-IT-WORKS.md).
model ImportFile {
  id            String      @id @default(uuid())
  importBatchId String
  /// Nome informado pelo navegador, já sanitizado. Nunca usado como caminho.
  originalName  String
  byteSize      Int
  /// SHA-256 do texto normalizado. Mesma base da impressão digital do lote.
  contentHash   String
  mediaType     String
  encoding      String
  createdAt     DateTime    @default(now())
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([contentHash])
}

/// Problema encontrado em uma linha do arquivo. Existe para que uma linha
/// ilegível seja declarada, e não silenciosamente omitida do lote.
model ImportIssue {
  id            String       @id @default(uuid())
  importBatchId String
  transactionId String?
  /// Linha do arquivo, contada a partir de 1, como a pessoa a vê.
  lineNumber    Int
  /// error | warning
  severity      String
  code          String
  message       String
  createdAt     DateTime     @default(now())
  importBatch   ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([transactionId])
}

/// Mapeamento de colunas reutilizável por instituição. Evita repetir a
/// conferência a cada extrato do mesmo banco.
model CsvMappingProfile {
  id               String       @id @default(uuid())
  profileId        String
  institutionId    String?
  name             String
  separator        String
  hasHeader        Boolean      @default(true)
  decimalSeparator String       @default("auto")
  /// Papéis das colunas, na ordem do arquivo, separados por vírgula.
  roles            String
  /// Assinatura do cabeçalho, para reconhecer o mesmo layout automaticamente.
  headerSignature  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  profile          LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution      Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@unique([profileId, name])
  @@index([profileId])
  @@index([profileId, headerSignature])
}

model Transaction {
  id            String        @id @default(uuid())
  profileId     String
  accountId     String
  importBatchId String?
  categoryId    String?
  occurredOn    DateTime
  description   String
  amountCents   BigInt
  /// pending | posted
  status        String        @default("pending")
  /// Identificador do lançamento no banco de origem (FITID no OFX, coluna de
  /// identificação no CSV). É a chave estável que impede que dois extratos com
  /// período sobreposto gravem o mesmo lançamento duas vezes.
  externalId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       LocalProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importIssues  ImportIssue[]

  @@unique([accountId, externalId])
  @@index([profileId, occurredOn])
  @@index([accountId, occurredOn])
  @@index([importBatchId])
  @@index([categoryId])
}

/// Compromisso com valor e vencimento. Subtraendo do Saldo Livre de Risco.
/// `status` é indispensável: sem ele, obrigação já paga continuaria sendo
/// descontada e o veredito ficaria errado por construção (docs/DASHBOARD.md, L-1).
model ScheduledObligation {
  id          String       @id @default(uuid())
  profileId   String
  accountId   String?
  categoryId  String?
  description String
  amountCents BigInt
  dueDate     DateTime
  /// open | paid | cancelled
  status      String       @default("open")
  /// none | monthly | weekly | yearly
  recurrence  String       @default("none")
  /// Valor informado como aproximado no onboarding.
  isEstimated Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  profile     LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId, status, dueDate])
  @@index([accountId])
  @@index([categoryId])
}

/// Entrada futura declarada. Não aumenta o Saldo Livre de Risco antes de ser
/// efetivamente registrada como transação.
model IncomeSource {
  id               String       @id @default(uuid())
  profileId        String
  accountId        String?
  description      String
  amountCents      BigInt
  frequency        String
  nextExpectedDate DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  profile          LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account          Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([profileId, isActive])
  @@index([accountId])
}

/// Regra local, determinística e revisável de classificação por estabelecimento.
model MerchantRule {
  id         String       @id @default(uuid())
  profileId  String
  categoryId String
  pattern    String
  matchType  String       @default("contains")
  priority   Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  profile    LocalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, pattern, matchType])
  @@index([profileId, isActive, priority])
  @@index([categoryId])
}
