# Copie para `.env` e preencha com valores locais. Este arquivo versionado contém
# somente nomes e placeholders sintéticos.
#
# Escopo: app local (SQLite), execução por Docker e o acesso da LP/BFF ao Worker.
# Os segredos do próprio Worker não moram aqui: ficam em `cloudflare/.dev.vars`
# (modelo em `cloudflare/.dev.vars.example`) e, em produção, em Worker Secrets.

# --- Sistema financeiro: SQLite local ---
# Único lugar onde extratos, contas, saldos e transações existem. O caminho é
# relativo ao diretório `prisma/`, e `temp/` é ignorado pelo Git.
DATABASE_URL="file:../temp/talentum-local.db"

# --- Docker ---
# Caminho do SQLite dentro do container `talentum-local`. É um caminho absoluto
# do volume `talentum-data`: dentro do container não existe `temp/` do host.
# Alterar isto sem mudar o volume do Compose deixa o banco fora do volume e o
# dado não sobrevive à recriação do container.
DOCKER_DATABASE_URL="file:/data/talentum-local.db"

# --- Cloudflare: o que precisa ser externo ---
# Nada financeiro passa por aqui. O D1 guarda apenas identidade mínima, sessões,
# releases e concessões, e é acessado somente pelo Worker — nunca pela LP nem
# pelo Electron. O binding `DB` e o `database_id` do D1 ficam em
# `cloudflare/wrangler.jsonc`, que é versionado porque o ID não é segredo.

# URL pública do Worker. Em desenvolvimento, `pnpm cloudflare:dev` responde em
# `http://127.0.0.1:8787`; a partir de um container, use
# `http://host.docker.internal:8787`.
CLOUDFLARE_API_BASE_URL="https://worker-exemplo.workers.dev"

# Autentica o BFF da LP no Worker. Precisa ser idêntico ao `BFF_SHARED_SECRET`
# cadastrado no Worker; valores diferentes fazem toda rota responder 403.
CLOUDFLARE_BFF_SHARED_SECRET="segredo-sintetico-compartilhado"
