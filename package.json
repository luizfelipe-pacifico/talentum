{
  "name": "talentum",
  "version": "0.1.0",
  "private": true,
  "description": "Talentum - Piloto Automatico Financeiro",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/luizfelipe-pacifico/talentum",
  "desktopName": "talentum.desktop",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "pnpm --dir apps/web dev",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:build:win": "pnpm desktop:prepare && electron-builder --win nsis --x64",
    "desktop:build:linux": "pnpm desktop:prepare && electron-builder --linux AppImage deb --x64",
    "desktop:build:mac": "pnpm desktop:prepare && electron-builder --mac dmg zip",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "instalador:gerar": "node scripts/gerar-instalador.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build --detach --wait",
    "docker:down": "docker compose down",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:manual": "node scripts/e2e-server.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "node scripts/migrate-dev.mjs",
    "lp:lut": "node scripts/gerar-lut.mjs",
    "lp:icones": "node scripts/gerar-icones-lp.mjs",
    "lp:telas": "node scripts/redimensionar-telas-lp.mjs",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:build": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc",
    "cloudflare:migrations:list:local": "wrangler d1 migrations list talentum-cloud-production --local --config cloudflare/wrangler.jsonc",
    "cloudflare:migrations:apply:local": "wrangler d1 migrations apply talentum-cloud-production --local --config cloudflare/wrangler.jsonc",
    "cloudflare:migrations:list:remote": "wrangler d1 migrations list talentum-cloud-production --remote --config cloudflare/wrangler.jsonc",
    "cloudflare:migrations:apply:remote": "wrangler d1 migrations apply talentum-cloud-production --remote --config cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "cloudflare:test": "node --test tests/cloud-contracts.test.mjs",
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "web:build": "pnpm --dir apps/web build",
    "hooks:install": "node scripts/install-hooks.mjs",
    "marca:gerar": "node scripts/gerar-marca.mjs",
    "estados:gerar": "node scripts/gerar-estados.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "^6.15.0",
    "@tailwindcss/postcss": "^4.3.5",
    "bootstrap-icons": "^1.13.2",
    "google-auth-library": "^11.3.4",
    "next": "^15.5.29",
    "pdfjs-dist": "^6.5.438",
    "prisma": "^6.15.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.165.0"
  },
  "build": {
    "appId": "org.talentum.app",
    "productName": "Talentum",
    "asar": false,
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "node_modules/prisma/**/*",
      "prisma/**/*",
      "package.json",
      "icon-badge.ico",
      "icon-badge.png",
      "!**/.env*",
      "!**/.dev.vars*",
      "!**/*.db*",
      "!**/*.key",
      "!**/*.vault"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*", "!**/.env*", "!**/.dev.vars*", "!**/*.db*", "!**/*.key", "!**/*.vault", "!.claude/**"]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": ["**/*"]
      }
    ],
    "win": { "target": "nsis", "icon": "icon-badge.ico", "artifactName": "Talentum-${version}-Windows-${arch}.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon-badge.png",
      "category": "Office;Finance",
      "executableName": "talentum",
      "syncDesktopName": true,
      "synopsis": "Finanças pessoais local-first",
      "description": "Lê extratos, organiza gastos e mostra quanto sobra, com os dados cifrados no computador.",
      "maintainer": "Projeto Talentum <https://github.com/luizfelipe-pacifico/talentum>",
      "artifactName": "Talentum-${version}-Linux-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icon-badge-mac.png",
      "category": "public.app-category.finance",
      "artifactName": "Talentum-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "Talentum-${version}-macOS-${arch}.${ext}",
      "title": "Talentum ${version}",
      "background": "packaging/instalador/dmg-fundo.png",
      "iconSize": 96,
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 140, "y": 232, "type": "file" },
        { "x": 400, "y": 232, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "language": "1046",
      "installerLanguages": ["pt_BR"],
      "multiLanguageInstaller": false,
      "installerIcon": "icon-badge.ico",
      "uninstallerIcon": "icon-badge.ico",
      "installerSidebar": "packaging/instalador/nsis-lateral.bmp",
      "uninstallerSidebar": "packaging/instalador/nsis-lateral.bmp",
      "installerHeader": "packaging/instalador/nsis-cabecalho.bmp",
      "shortcutName": "Talentum",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
